// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  wallets      Wallet[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
}

model Wallet {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  currency     String   @default("USD")
  icon         String   @default("💳")
  color        String   @default("#6366f1")
  startBalance Float    @default(0)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())

  transactions       Transaction[] @relation("WalletTransactions")
  incomingTransfers  Transaction[] @relation("TransferToWallet")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String // "expense" | "income"
  icon      String   @default("🏷️")
  color     String   @default("#6366f1")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId           String
  wallet             Wallet    @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type               String // "expense" | "income" | "transfer"
  amount             Float
  note               String?
  date               DateTime
  transferToWalletId String?
  transferToWallet   Wallet?   @relation("TransferToWallet", fields: [transferToWalletId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, date])
  @@index([walletId])
  @@index([categoryId])
}

model Budget {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String    @default("")
  amount     Float
  month      Int
  year       Int
  createdAt  DateTime  @default(now())

  @@unique([userId, categoryId, month, year])
}
